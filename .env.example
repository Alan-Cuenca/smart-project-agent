# Servidor
PORT=3000
# URL pública del servidor (la usan los botones Aprobar/Rechazar del correo).
# Con localhost los botones solo funcionan en el mismo equipo. Ej: https://mi-agente.onrender.com
APP_BASE_URL=http://localhost:3000
# Protege /api/test-agent y /api/pending-actions (header x-admin-token). Vacío = sin protección (solo desarrollo).
# En producción es obligatorio y debe tener al menos 32 caracteres.
ADMIN_TOKEN=
# Días de vigencia de los enlaces de aprobación del correo
ACTION_TTL_DAYS=14

# Almacén de acciones: si se definen, se usa Supabase; si no, data/acciones.json (solo desarrollo)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Alternativa a project.config.json (usada en Render / GitHub Actions): el JSON completo en una línea
PROJECT_CONFIG_JSON=

# Google Gemini AI
GEMINI_API_KEY=
# Modelo principal (por defecto gemini-3.8-flash)
GEMINI_MODEL=
# Modelos de respaldo separados por coma, en orden. Vacío = lista por defecto (ver src/agents/modelo.js)
# Nota: el plan gratuito permite ~20 solicitudes/día POR MODELO; cada auditoría usa 3.
GEMINI_FALLBACK_MODELS=
# Tiempo máximo por intento (ms) y reintentos por modelo
GEMINI_TIMEOUT_MS=120000
GEMINI_MAX_RETRIES=1

# Trello
TRELLO_API_KEY=
TRELLO_TOKEN=
# true = las aprobaciones se registran pero NO modifican Trello (útil para pruebas)
TRELLO_DRY_RUN=false

# GitHub
GITHUB_TOKEN=

# Tareas programadas (expresiones cron, "off" para desactivar)
CRON_AUDITORIA_DIARIA=0 8 * * 1-5
CRON_REPORTE_SEMANAL=0 17 * * 5

# SMTP / Email Alerts
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
