# Servidor
PORT=3000
# URL pública del servidor (la usan los botones Aprobar/Rechazar del correo).
# Con localhost los botones solo funcionan en el mismo equipo. Ej: https://mi-agente.onrender.com
APP_BASE_URL=http://localhost:3000
# Protege /api/test-agent y /api/pending-actions (header x-admin-token). Vacío = sin protección.
ADMIN_TOKEN=

# Google Gemini AI
GEMINI_API_KEY=
GEMINI_MODEL=

# Trello
TRELLO_API_KEY=
TRELLO_TOKEN=
# true = las aprobaciones se registran pero NO modifican Trello (útil para pruebas)
TRELLO_DRY_RUN=false

# GitHub
GITHUB_TOKEN=

# SMTP / Email Alerts
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
